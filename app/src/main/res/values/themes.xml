<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RikoMusic" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Plan 3.3: platform splash (cold window shows the launcher mark)
         then hands off to the RIKO branded composable transition. -->
    <style name="Theme.RikoMusic.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.RikoMusic</item>
    </style>
</resources>
