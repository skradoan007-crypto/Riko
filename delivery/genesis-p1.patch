@@ -0,0 +1,17 @@
+package com.rikodev.music.android.dna.genome;
+
+/** Algorithm IDs are persistent data. Never reorder, reuse, or silently upgrade them. */
+public enum DnaAlgorithmVersion {
+    GENESIS_V1(1);
+
+    private final int id;
+
+    DnaAlgorithmVersion(int id) { this.id = id; }
+
+    public int getId() { return id; }
+
+    public static DnaAlgorithmVersion fromId(int id) {
+        if (id == 1) return GENESIS_V1;
+        throw new IllegalArgumentException("Unsupported DNA algorithm: " + id);
+    }
+}
diff --git a/app/src/main/java/com/rikodev/music/android/dna/genome/DnaCodec.java b/app/src/main/java/com/rikodev/music/android/dna/genome/DnaCodec.java
new file mode 100644
index 0000000..81459e3
--- /dev/null
+++ b/app/src/main/java/com/rikodev/music/android/dna/genome/DnaCodec.java
@@ -0,0 +1,119 @@
+package com.rikodev.music.android.dna.genome;
+
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.util.Objects;
+import java.util.zip.CRC32;
+
+/**
+ * Internal, bounded binary persistence format; not the P7 portable DNA code.
+ * Big-endian, fixed V1 size, separate wire/algorithm versions, CRC32 corruption check.
+ * CRC is not authentication. Unknown versions, invalid values and trailing bytes fail closed.
+ */
+public final class DnaCodec {
+    private static final int FEATURES_MAGIC = 0x4d444645; // MDFE
+    private static final int GENOME_MAGIC = 0x4d44474e; // MDGN
+    private static final int WIRE_VERSION = 1;
+    public static final int FEATURES_BYTES = 90;
+    public static final int GENOME_BYTES = 125;
+
+    private DnaCodec() {}
+
+    public static byte[] encodeFeatures(DnaFeatures features) {
+        Objects.requireNonNull(features, "features");
+        ByteBuffer out = start(FEATURES_MAGIC, FEATURES_BYTES);
+        putFeaturePayload(out, features);
+        return finish(out);
+    }
+
+    public static DnaFeatures decodeFeatures(byte[] bytes) {
+        ByteBuffer in = checked(bytes, FEATURES_MAGIC, FEATURES_BYTES);
+        int bass = in.getInt(), mid = in.getInt(), treble = in.getInt();
+        int centroid = in.getInt(), flux = in.getInt(), tempo = in.getInt();
+        int confidence = in.getInt(), dynamicRange = in.getInt();
+        return DnaFeatures.fromCanonical(bass, mid, treble, centroid, flux, tempo,
+                confidence, dynamicRange, readChroma(in));
+    }
+
+    public static byte[] encodeGenome(DnaGenome genome) {
+        Objects.requireNonNull(genome, "genome");
+        ByteBuffer out = start(GENOME_MAGIC, GENOME_BYTES);
+        out.putShort((short) genome.getAlgorithmVersion().getId());
+        out.putLong(genome.getSeed()).putLong(genome.getGeometrySeed());
+        out.put((byte) genome.getArchetype().getId());
+        out.putInt(genome.getParticleCount()).putInt(genome.getLayerCount()).putInt(genome.getSymmetry());
+        out.putInt(genome.getBodyExpansionPpm()).putInt(genome.getBrightnessPpm());
+        out.putInt(genome.getSurfaceSharpnessPpm()).putInt(genome.getTransientBurstPpm());
+        out.putInt(genome.getRhythmMilliBpm()).putInt(genome.getDeformationPpm());
+        out.putInt(genome.getFlowSpeedPpm()).putInt(genome.getMicroDetailPpm());
+        out.putInt(genome.getPaletteRotationMilliDegrees());
+        for (int i = 0; i < 12; i++) out.putInt(genome.chromaAt(i));
+        return finish(out);
+    }
+
+    public static DnaGenome decodeGenome(byte[] bytes) {
+        ByteBuffer in = checked(bytes, GENOME_MAGIC, GENOME_BYTES);
+        DnaAlgorithmVersion version = DnaAlgorithmVersion.fromId(in.getShort() & 0xffff);
+        long seed = in.getLong(), geometrySeed = in.getLong();
+        DnaGenome.Archetype archetype = DnaGenome.Archetype.fromId(in.get() & 0xff);
+        int particles = in.getInt(), layers = in.getInt(), symmetry = in.getInt();
+        int expansion = in.getInt(), brightness = in.getInt(), sharpness = in.getInt();
+        int burst = in.getInt(), rhythm = in.getInt(), deformation = in.getInt();
+        int flow = in.getInt(), detail = in.getInt(), rotation = in.getInt();
+        return new DnaGenome(version, seed, geometrySeed, archetype, particles, layers,
+                symmetry, expansion, brightness, sharpness, burst, rhythm, deformation,
+                flow, detail, rotation, readChroma(in));
+    }
+
+    // This 80-byte order is part of algorithm V1, independent of future wire envelopes.
+    static byte[] featurePayloadV1(DnaFeatures features) {
+        ByteBuffer out = ByteBuffer.allocate(80).order(ByteOrder.BIG_ENDIAN);
+        putFeaturePayload(out, features);
+        return out.array();
+    }
+
+    private static void putFeaturePayload(ByteBuffer out, DnaFeatures f) {
+        out.putInt(f.getBassEnergyPpm()).putInt(f.getMidEnergyPpm()).putInt(f.getTrebleEnergyPpm());
+        out.putInt(f.getCentroidMilliHz()).putInt(f.getSpectralFluxPpm()).putInt(f.getTempoMilliBpm());
+        out.putInt(f.getTempoConfidencePpm()).putInt(f.getDynamicRangeMilliDb());
+        for (int i = 0; i < 12; i++) out.putInt(f.chromaAt(i));
+    }
+
+    private static int[] readChroma(ByteBuffer in) {
+        int[] chroma = new int[12];
+        for (int i = 0; i < chroma.length; i++) chroma[i] = in.getInt();
+        return chroma;
+    }
+
+    private static ByteBuffer start(int magic, int length) {
+        ByteBuffer out = ByteBuffer.allocate(length).order(ByteOrder.BIG_ENDIAN);
+        out.putInt(magic).putShort((short) WIRE_VERSION);
+        return out;
+    }
+
+    private static byte[] finish(ByteBuffer out) {
+        if (out.position() != out.capacity() - 4) throw new IllegalStateException("DNA codec size mismatch");
+        CRC32 crc = new CRC32();
+        crc.update(out.array(), 0, out.position());
+        out.putInt((int) crc.getValue());
+        return out.array();
+    }
+
+    private static ByteBuffer checked(byte[] bytes, int magic, int length) {
+        Objects.requireNonNull(bytes, "bytes");
+        if (bytes.length != length) throw new IllegalArgumentException("Invalid DNA blob length");
+        // Copy once, after the size limit, so caller mutation cannot change validated input.
+        byte[] copy = bytes.clone();
+        CRC32 crc = new CRC32();
+        crc.update(copy, 0, length - 4);
+        ByteBuffer in = ByteBuffer.wrap(copy).order(ByteOrder.BIG_ENDIAN);
+        if (in.getInt(length - 4) != (int) crc.getValue()) {
+            throw new IllegalArgumentException("DNA blob checksum mismatch");
+        }
+        if (in.getInt() != magic) throw new IllegalArgumentException("Wrong DNA blob type");
+        if ((in.getShort() & 0xffff) != WIRE_VERSION) {
+            throw new IllegalArgumentException("Unsupported DNA wire version");
+        }
+        return in;
+    }
+}
diff --git a/app/src/main/java/com/rikodev/music/android/dna/genome/DnaFeatures.java b/app/src/main/java/com/rikodev/music/android/dna/genome/DnaFeatures.java
new file mode 100644
index 0000000..7ae0d96
--- /dev/null
+++ b/app/src/main/java/com/rikodev/music/android/dna/genome/DnaFeatures.java
@@ -0,0 +1,148 @@
+package com.rikodev.music.android.dna.genome;
+
+import java.util.Arrays;
+import java.util.Objects;
+
+/**
+ * Immutable, canonical song summary, independent of live spectrum and playback time.
+ * Units: normalized energies/flux/confidence/chroma in ppm; centroid in milli-Hz;
+ * tempo in milli-BPM; dynamic range in milli-dB. Chroma order is C through B.
+ * See docs/mdna/genesis/P1_CORE.md for the frozen V1 extraction-input contract.
+ */
+public final class DnaFeatures {
+    public static final int UNIT = 1_000_000;
+    private final int bassEnergyPpm;
+    private final int midEnergyPpm;
+    private final int trebleEnergyPpm;
+    private final int centroidMilliHz;
+    private final int spectralFluxPpm;
+    private final int tempoMilliBpm;
+    private final int tempoConfidencePpm;
+    private final int dynamicRangeMilliDb;
+    private final int[] chromaPpm;
+
+    private DnaFeatures(int bass, int mid, int treble, int centroid, int flux,
+                        int tempo, int confidence, int dynamicRange, int[] chroma) {
+        bassEnergyPpm = range(bass, 0, UNIT, "bass");
+        midEnergyPpm = range(mid, 0, UNIT, "mid");
+        trebleEnergyPpm = range(treble, 0, UNIT, "treble");
+        centroidMilliHz = range(centroid, 0, 11_025_000, "centroid");
+        spectralFluxPpm = range(flux, 0, UNIT, "flux");
+        tempoMilliBpm = range(tempo, 0, 300_000, "tempo");
+        tempoConfidencePpm = range(confidence, 0, UNIT, "tempo confidence");
+        if (tempo == 0 && confidence != 0) {
+            throw new IllegalArgumentException("Unknown tempo must have zero confidence");
+        }
+        dynamicRangeMilliDb = range(dynamicRange, 0, 120_000, "dynamic range");
+        chromaPpm = copyChroma(chroma);
+    }
+
+    public static DnaFeatures fromCanonical(int bass, int mid, int treble, int centroid,
+            int flux, int tempo, int confidence, int dynamicRange, int[] chroma) {
+        return new DnaFeatures(bass, mid, treble, centroid, flux, tempo, confidence,
+                dynamicRange, chroma);
+    }
+
+    /**
+     * Half-up quantization, no silent clamping. Chroma input is already L1 normalized
+     * (sum within 1e-6 of 1), or all-zero for unknown/silent chroma. Largest-remainder
+     * quantization gives exactly UNIT total; ties go to the lower pitch class.
+     */
+    public static DnaFeatures fromNormalized(double bass, double mid, double treble,
+            double centroidHz, double flux, double bpm, double confidence,
+            double dynamicRangeDb, double[] chroma) {
+        if (bpm == 0.0 && confidence != 0.0) {
+            throw new IllegalArgumentException("Unknown tempo must have zero confidence");
+        }
+        Objects.requireNonNull(chroma, "chroma");
+        if (chroma.length != 12) throw new IllegalArgumentException("Expected 12 chroma bins");
+        double[] input = chroma.clone();
+        double sum = 0;
+        for (double value : input) {
+            requireFiniteRange(value, 1.0, "chroma");
+            sum += value;
+        }
+        int[] canonical = new int[12];
+        if (sum != 0.0) {
+            if (StrictMath.abs(sum - 1.0) > 0.000001) {
+                throw new IllegalArgumentException("Chroma must be L1 normalized");
+            }
+            double[] remainders = new double[12];
+            int total = 0;
+            for (int i = 0; i < 12; i++) {
+                double scaled = input[i] / sum * UNIT;
+                canonical[i] = (int) StrictMath.floor(scaled);
+                remainders[i] = scaled - canonical[i];
+                total += canonical[i];
+            }
+            for (int left = UNIT - total; left > 0; left--) {
+                int best = 0;
+                for (int i = 1; i < 12; i++) {
+                    if (remainders[i] > remainders[best]) best = i;
+                }
+                canonical[best]++;
+                remainders[best] = -1;
+            }
+        }
+        return fromCanonical(quantize(bass, 1, UNIT, "bass"),
+                quantize(mid, 1, UNIT, "mid"), quantize(treble, 1, UNIT, "treble"),
+                quantize(centroidHz, 11025, 1000, "centroid"),
+                quantize(flux, 1, UNIT, "flux"), quantize(bpm, 300, 1000, "tempo"),
+                quantize(confidence, 1, UNIT, "tempo confidence"),
+                quantize(dynamicRangeDb, 120, 1000, "dynamic range"), canonical);
+    }
+
+    static int range(int value, int min, int max, String name) {
+        if (value < min || value > max) throw new IllegalArgumentException(name + " out of range");
+        return value;
+    }
+
+    private static void requireFiniteRange(double value, double max, String name) {
+        if (!Double.isFinite(value) || value < 0 || value > max) {
+            throw new IllegalArgumentException(name + " must be finite and in range");
+        }
+    }
+
+    private static int quantize(double value, double max, int scale, String name) {
+        requireFiniteRange(value, max, name);
+        return (int) StrictMath.floor(value * scale + 0.5);
+    }
+
+    static int[] copyChroma(int[] values) {
+        Objects.requireNonNull(values, "chroma");
+        if (values.length != 12) throw new IllegalArgumentException("Expected 12 chroma bins");
+        int[] copy = values.clone();
+        int sum = 0;
+        for (int value : copy) sum += range(value, 0, UNIT, "chroma");
+        if (sum != 0 && sum != UNIT) throw new IllegalArgumentException("Invalid chroma total");
+        return copy;
+    }
+
+    public int getBassEnergyPpm() { return bassEnergyPpm; }
+    public int getMidEnergyPpm() { return midEnergyPpm; }
+    public int getTrebleEnergyPpm() { return trebleEnergyPpm; }
+    public int getCentroidMilliHz() { return centroidMilliHz; }
+    public int getSpectralFluxPpm() { return spectralFluxPpm; }
+    public int getTempoMilliBpm() { return tempoMilliBpm; }
+    public int getTempoConfidencePpm() { return tempoConfidencePpm; }
+    public int getDynamicRangeMilliDb() { return dynamicRangeMilliDb; }
+    public int[] getChromaPpm() { return chromaPpm.clone(); }
+    public int chromaAt(int pitchClass) { return chromaPpm[pitchClass]; }
+
+    @Override public boolean equals(Object other) {
+        if (this == other) return true;
+        if (!(other instanceof DnaFeatures)) return false;
+        DnaFeatures f = (DnaFeatures) other;
+        return bassEnergyPpm == f.bassEnergyPpm && midEnergyPpm == f.midEnergyPpm
+                && trebleEnergyPpm == f.trebleEnergyPpm && centroidMilliHz == f.centroidMilliHz
+                && spectralFluxPpm == f.spectralFluxPpm && tempoMilliBpm == f.tempoMilliBpm
+                && tempoConfidencePpm == f.tempoConfidencePpm
+                && dynamicRangeMilliDb == f.dynamicRangeMilliDb && Arrays.equals(chromaPpm, f.chromaPpm);
+    }
+
+    @Override public int hashCode() {
+        return 31 * Objects.hash(bassEnergyPpm, midEnergyPpm, trebleEnergyPpm,
+                centroidMilliHz, spectralFluxPpm, tempoMilliBpm, tempoConfidencePpm,
+                dynamicRangeMilliDb) + Arrays.hashCode(chromaPpm);
+    }
+}
diff --git a/app/src/main/java/com/rikodev/music/android/dna/genome/DnaGenome.java b/app/src/main/java/com/rikodev/music/android/dna/genome/DnaGenome.java
