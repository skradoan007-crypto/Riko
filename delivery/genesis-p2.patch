diff --git a/app/src/androidTest/java/com/rikodev/music/android/dna/analysis/OfflineDnaAnalyzerDeviceTest.kt b/app/src/androidTest/java/com/rikodev/music/android/dna/analysis/OfflineDnaAnalyzerDeviceTest.kt
